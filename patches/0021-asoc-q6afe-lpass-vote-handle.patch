From: DBY-W09 contributors <dby-w09@users.noreply.github.com>
Subject: [PATCH] ASoC: q6afe: return LPASS vote handles and wait for unvote

The dedicated vote response contains one client handle, not an APR basic
response. Check its length before reading it and pass the nonzero handle
back to the clock provider. Keep the transaction mutex held until the
handle is consumed so simultaneous clock prepares cannot exchange handles.

Handle basic vote errors and unvote acknowledgements, and wait for the
latter before reporting success. An empty handle is a no-op on unvote.
Publish vote response data before waking the waiter. The cached response
handle is reset on each vote and belongs to the devm-allocated AFE
instance; APR removal and reprobe also recreate its clock-provider
children.

Signed-off-by: DBY-W09 contributors <dby-w09@users.noreply.github.com>
---
--- a/sound/soc/qcom/qdsp6/q6afe.c
+++ b/sound/soc/qcom/qdsp6/q6afe.c
@@ -379,6 +379,7 @@
 	struct q6core_svc_api_info ainfo;
 	struct mutex lock;
 	struct aprv2_ibasic_rsp_result_t result;
+	u32 client_handle;
 	wait_queue_head_t wait;
 	struct list_head port_list;
 	spinlock_t port_list_lock;
@@ -967,6 +968,7 @@
 	struct q6afe *afe = dev_get_drvdata(&adev->dev);
 	const struct aprv2_ibasic_rsp_result_t *res;
 	const struct apr_hdr *hdr = &data->hdr;
+	const u32 *payload = data->payload;
 	struct q6afe_port *port;
 
 	if (!data->payload_size)
@@ -975,11 +977,21 @@
 	res = data->payload;
 	switch (hdr->opcode) {
 	case APR_BASIC_RSP_RESULT: {
+		if (data->payload_size < sizeof(*res))
+			return 0;
+
 		if (res->status) {
 			dev_err(afe->dev, "cmd = 0x%x returned error = 0x%x\n",
 				res->opcode, res->status);
 		}
 		switch (res->opcode) {
+		case AFE_CMD_REMOTE_LPASS_CORE_HW_VOTE_REQUEST:
+		case AFE_CMD_REMOTE_LPASS_CORE_HW_DEVOTE_REQUEST:
+			afe->result.status = res->status;
+			/* Publish status before the waiter observes completion. */
+			smp_store_release(&afe->result.opcode, res->opcode);
+			wake_up(&afe->wait);
+			break;
 		case AFE_PORT_CMD_SET_PARAM_V2:
 		case AFE_PORT_CMD_DEVICE_STOP:
 		case AFE_PORT_CMD_DEVICE_START:
@@ -1001,8 +1013,13 @@
 	}
 		break;
 	case AFE_CMD_RSP_REMOTE_LPASS_CORE_HW_VOTE_REQUEST:
-		afe->result.opcode = hdr->opcode;
-		afe->result.status = res->status;
+		if (data->payload_size < sizeof(u32))
+			return 0;
+
+		afe->client_handle = payload[0];
+		afe->result.status = 0;
+		/* Publish the handle and status together with completion. */
+		smp_store_release(&afe->result.opcode, hdr->opcode);
 		wake_up(&afe->wait);
 		break;
 	default:
@@ -1028,14 +1045,15 @@
 }
 EXPORT_SYMBOL_GPL(q6afe_get_port_id);
 
-static int afe_apr_send_pkt(struct q6afe *afe, struct apr_pkt *pkt,
+/* Caller holds afe->lock through response consumption. */
+static int __afe_apr_send_pkt(struct q6afe *afe, struct apr_pkt *pkt,
 			    struct q6afe_port *port, uint32_t rsp_opcode)
 {
 	wait_queue_head_t *wait;
 	struct aprv2_ibasic_rsp_result_t *result;
 	int ret;
 
-	mutex_lock(&afe->lock);
+	lockdep_assert_held(&afe->lock);
 	if (port) {
 		wait = &port->wait;
 		result = &port->result;
@@ -1054,7 +1072,11 @@
 		goto err;
 	}
 
-	ret = wait_event_timeout(*wait, (result->opcode == rsp_opcode),
+	/* Pair with the vote callbacks before consuming status or handle. */
+	ret = wait_event_timeout(*wait,
+				 smp_load_acquire(&result->opcode) == rsp_opcode ||
+				 (smp_load_acquire(&result->opcode) == pkt->hdr.opcode &&
+				  result->status),
 				 msecs_to_jiffies(TIMEOUT_MS));
 	if (!ret) {
 		ret = -ETIMEDOUT;
@@ -1067,8 +1089,17 @@
 	}
 
 err:
+	return ret;
+}
+
+static int afe_apr_send_pkt(struct q6afe *afe, struct apr_pkt *pkt,
+			  struct q6afe_port *port, uint32_t rsp_opcode)
+{
+	int ret;
+
+	mutex_lock(&afe->lock);
+	ret = __afe_apr_send_pkt(afe, pkt, port, rsp_opcode);
 	mutex_unlock(&afe->lock);
-
 	return ret;
 }
 
@@ -1844,6 +1875,11 @@
 	int ret = 0;
 	int pkt_size = APR_HDR_SIZE + sizeof(*vote_cfg);
 
+	if (!client_handle) {
+		dev_dbg_once(afe->dev, "Skipping unvote without a client handle\n");
+		return 0;
+	}
+
 	void *p __free(kfree) = kzalloc(pkt_size, GFP_KERNEL);
 	if (!p)
 		return -ENOMEM;
@@ -1862,7 +1898,8 @@
 	vote_cfg->hw_block_id = hw_block_id;
 	vote_cfg->client_handle = client_handle;
 
-	ret = apr_send_pkt(afe->apr, pkt);
+	ret = afe_apr_send_pkt(afe, pkt, NULL,
+			       AFE_CMD_REMOTE_LPASS_CORE_HW_DEVOTE_REQUEST);
 	if (ret < 0)
 		dev_err(afe->dev, "AFE failed to unvote (%d)\n", hw_block_id);
 
@@ -1898,8 +1935,18 @@
 	strscpy(vote_cfg->client_name, client_name,
 			sizeof(vote_cfg->client_name));
 
-	ret = afe_apr_send_pkt(afe, pkt, NULL,
-			       AFE_CMD_RSP_REMOTE_LPASS_CORE_HW_VOTE_REQUEST);
+	/* Keep the response handle private until it is copied to this caller. */
+	mutex_lock(&afe->lock);
+	afe->client_handle = 0;
+	ret = __afe_apr_send_pkt(afe, pkt, NULL,
+				AFE_CMD_RSP_REMOTE_LPASS_CORE_HW_VOTE_REQUEST);
+	if (!ret) {
+		if (afe->client_handle)
+			*client_handle = afe->client_handle;
+		else
+			ret = -EINVAL;
+	}
+	mutex_unlock(&afe->lock);
 	if (ret)
 		dev_err(afe->dev, "AFE failed to vote (%d)\n", hw_block_id);
 
