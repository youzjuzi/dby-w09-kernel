+/* Keep the packet type explicit: short and long writes are not interchangeable. */
+struct dby_w09_cmd {
+	u8 type;
+	u8 delay_ms;
+	u8 len;
+	u8 data[6];
+};
+
+/* Owner-generated data; see docs/panel-data.md in dby-w09-kernel. */
+#include "dby-w09-panel-data.h"
+
+static int dby_w09_send(struct panel_info *pinfo,
+			const struct dby_w09_cmd *cmds, size_t count)
+{
+	size_t i;
+	int link;
+
+	for (i = 0; i < count; i++) {
+		for (link = 0; link < ARRAY_SIZE(pinfo->dsi); link++) {
+			struct mipi_dsi_device *dsi = pinfo->dsi[link];
+			struct mipi_dsi_msg msg = {
+				.channel = dsi->channel,
+				.type = cmds[i].type,
+				.flags = MIPI_DSI_MSG_USE_LPM,
+				.tx_len = cmds[i].len,
+				.tx_buf = cmds[i].data,
+			};
+			ssize_t ret;
+
+			if (!dsi->host->ops || !dsi->host->ops->transfer)
+				return -EOPNOTSUPP;
+
+			ret = dsi->host->ops->transfer(dsi->host, &msg);
+			if (ret < 0)
+				return ret;
+		}
+		if (cmds[i].delay_ms)
+			msleep(cmds[i].delay_ms);
+	}
+
+	return 0;
+}
+
+static int dby_w09_init_sequence(struct panel_info *pinfo)
+{
+	return dby_w09_send(pinfo, dby_w09_on, ARRAY_SIZE(dby_w09_on));
+}
+
+static int dby_w09_off_sequence(struct panel_info *pinfo)
+{
+	return dby_w09_send(pinfo, dby_w09_off, ARRAY_SIZE(dby_w09_off));
+}
