+static unsigned int dby_w09_current_refresh(struct panel_info *pinfo)
+{
+	struct drm_connector_state *state;
+	struct drm_crtc_state *crtc_state;
+	unsigned int hz;
+
+	/* get_modes records the connector; prepare runs after the atomic swap. */
+	state = pinfo->connector ? pinfo->connector->state : NULL;
+	crtc_state = state && state->crtc ? state->crtc->state : NULL;
+	if (crtc_state) {
+		hz = drm_mode_vrefresh(&crtc_state->adjusted_mode);
+		if (hz == 30 || hz == 60 || hz == 120)
+			return hz;
+	}
+
+	if (!pinfo->mode_fallback_warned) {
+		dev_warn(pinfo->panel.dev,
+			 "panel: no supported current mode, using preferred %d Hz\n",
+			 refresh_hz);
+		pinfo->mode_fallback_warned = true;
+	}
+	return refresh_hz;
+}
+
+static u8 dby_w09_refresh_value(unsigned int hz)
+{
+	switch (hz) {
+	case 30:
+		return 0x0e;
+	case 120:
+		return 0x0d;
+	default: /* 60 Hz; current_refresh only returns the three supported rates. */
+		return 0x0c;
+	}
+}
+
+static int dby_w09_set_refresh(struct panel_info *pinfo)
+{
+	unsigned int hz = dby_w09_current_refresh(pinfo);
+	u8 value = dby_w09_refresh_value(hz);
+	const struct dby_w09_cmd cmds[] = {
+		{ MIPI_DSI_DCS_LONG_WRITE, 0, 2, { 0xff, 0x2a } },
+		{ MIPI_DSI_DCS_LONG_WRITE, 0, 2, { 0xfb, 0x01 } },
+		{ MIPI_DSI_DCS_LONG_WRITE, 0, 2, { 0x23, value } },
+		{ MIPI_DSI_DCS_LONG_WRITE, 0, 2, { 0xff, 0x10 } },
+	};
+
+	dev_info(pinfo->panel.dev, "panel: mode %u Hz, 0x23=0x%02x\n", hz, value);
+	/* Stock to-30/60/120 values, sent in LP with the init sequence. */
+	return dby_w09_send(pinfo, cmds, ARRAY_SIZE(cmds), MIPI_DSI_MSG_USE_LPM);
+}
+
 static int dby_w09_init_sequence(struct panel_info *pinfo)
 {
-	return dby_w09_send(pinfo, dby_w09_on, ARRAY_SIZE(dby_w09_on));
+	size_t sleep_out;
+	int ret;
+
+	/*
+	 * Keep the pinned owner table intact, including its initial 60 Hz write.
+	 * Insert the selected rate immediately before sleep-out/display-on, where
+	 * the table is already on page 0x10; return to that page before resuming.
+	 * No packet index, delay, power sequencing or off-command change.
+	 */
+	for (sleep_out = 0; sleep_out < ARRAY_SIZE(dby_w09_on); sleep_out++)
+		if (dby_w09_on[sleep_out].type == MIPI_DSI_DCS_SHORT_WRITE &&
+		    dby_w09_on[sleep_out].len == 1 &&
+		    dby_w09_on[sleep_out].data[0] == MIPI_DCS_EXIT_SLEEP_MODE)
+			break;
+	if (sleep_out == ARRAY_SIZE(dby_w09_on))
+		return -EINVAL;
+
+	ret = dby_w09_send(pinfo, dby_w09_on, sleep_out, MIPI_DSI_MSG_USE_LPM);
+	if (ret)
+		return ret;
+	ret = dby_w09_set_refresh(pinfo);
+	if (ret)
+		return ret;
+	return dby_w09_send(pinfo, dby_w09_on + sleep_out,
+			    ARRAY_SIZE(dby_w09_on) - sleep_out, MIPI_DSI_MSG_USE_LPM);
 }
 
 static int dby_w09_off_sequence(struct panel_info *pinfo)
 {
-	return dby_w09_send(pinfo, dby_w09_off, ARRAY_SIZE(dby_w09_off));
+	return dby_w09_send(pinfo, dby_w09_off, ARRAY_SIZE(dby_w09_off),
+			    MIPI_DSI_MSG_USE_LPM);
 }
 
