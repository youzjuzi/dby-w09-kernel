+static int dby_profile_set(const char *val, const struct kernel_param *kp)
+{
+	int value, ret;
+
+	ret = kstrtoint(val, 0, &value);
+	if (ret)
+		return ret;
+	if (kp->arg == &refresh_hz) {
+		if (value != 60 && value != 120)
+			return -EINVAL;
+	} else if (value != 0 && value != 1) {
+		return -EINVAL;
+	}
+
+	/* DBY-W09 debug: Do not advertise a change that needs a new attach. */
+	if (dby_params_locked && value != *(int *)kp->arg)
+		return -EBUSY;
+	*(int *)kp->arg = value;
+	return 0;
+}
+
+static const struct kernel_param_ops dby_profile_ops = {
+	.set = dby_profile_set,
+	.get = param_get_int,
+};
+module_param_cb(refresh_hz, &dby_profile_ops, &refresh_hz, 0600);
+MODULE_PARM_DESC(refresh_hz, "DBY refresh 60/120; reload module to change after probe");
+module_param_cb(non_burst, &dby_profile_ops, &non_burst, 0600);
+MODULE_PARM_DESC(non_burst, "DBY non-burst 0/1; reload module to change after probe");
