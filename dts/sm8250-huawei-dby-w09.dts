/* Project board baseline. See provenance.md. */
/dts-v1/;
#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
#include "sm8250.dtsi"
#include "pm8150.dtsi"
#include <dt-bindings/leds/common.h>

/* Minimal PM8150L nodes from upstream pm8150l.dtsi. The owner-supplied
 * runtime FDT places the indicator on USID 5: PWM 0/red, PWM 1/green.
 * LPG LED reg is one-based. Stock brightness ratios are 70/255 and 120/255;
 * userspace applies those ratios to the independent LED class devices.
 */
&spmi_bus {
	/* Revision information only; required by the USID 5 parent driver. */
	pmic@4 {
		compatible = "qcom,pm8150l", "qcom,spmi-pmic";
		reg = <0x4 SPMI_USID>;
		#address-cells = <1>;
		#size-cells = <0>;
	};

	pmic@5 {
		compatible = "qcom,pm8150l", "qcom,spmi-pmic";
		reg = <0x5 SPMI_USID>;
		#address-cells = <1>;
		#size-cells = <0>;

		pwm {
			compatible = "qcom,pm8150l-lpg";
			#address-cells = <1>;
			#size-cells = <0>;
			#pwm-cells = <2>;
			status = "okay";

			led@1 {
				reg = <1>;
				color = <LED_COLOR_ID_RED>;
				linux,default-trigger = "dby-chg-red";
				function = LED_FUNCTION_CHARGING;
				default-state = "off";
			};

			led@2 {
				reg = <2>;
				color = <LED_COLOR_ID_GREEN>;
				linux,default-trigger = "dby-chg-green";
				function = LED_FUNCTION_CHARGING;
				default-state = "off";
			};
		};
	};
};
/ {
	battery: battery {
		compatible = "simple-battery";
		device-chemistry = "lithium-ion-polymer";
		charge-full-design-microamp-hours = <7150000>;
		/* Estimate: 7150 mAh * 3.87 V; nominal voltage unverified. */
		energy-full-design-microwatt-hours = <27670500>;
		voltage-max-design-microvolt = <4400000>;
	};

	/* Idea from CoWave-Fall's linux-on-arm-matepad11;
	 * reimplemented, no code copied.
	 */
	vibrator {
		compatible = "gpio-vibrator";
		enable-gpios = <&tlmm 72 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&vibrator_default>;
	};
};

&tlmm {
	vibrator_default: vibrator-default-state {
		pins = "gpio72";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
		output-low;
	};
};

/ { model="Huawei DBY-W09"; compatible="huawei,dby-w09", "qcom,sm8250"; /delete-node/ reserved-memory; /delete-node/ memory@80000000; aliases { mmc0=&sdhc_2; serial1=&uart6; };
 display-hold {
  compatible = "huawei,dby-w09-display-hold";
  power-domains = <&rpmhpd SM8250_MMCX>, <&rpmhpd SM8250_MX>, <&rpmhpd SM8250_CX>;
  interconnects = <&mmss_noc MASTER_MDP_PORT0 0 &mc_virt SLAVE_EBI_CH0 0>,
                  <&mmss_noc MASTER_MDP_PORT1 0 &mc_virt SLAVE_EBI_CH0 0>;
 };
};
