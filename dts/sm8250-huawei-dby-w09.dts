&apps_rsc {
 regulators { compatible="qcom,pm8150l-rpmh-regulators"; qcom,pmic-id="c";
  vdd_sd: ldo9 { regulator-name="sd-vdd"; regulator-min-microvolt=<2960000>; regulator-max-microvolt=<2960000>; regulator-initial-mode=<RPMH_REGULATOR_MODE_HPM>; };
  vdd_io_sd: ldo6 { regulator-name="sd-vdd-io"; regulator-min-microvolt=<2960000>; regulator-max-microvolt=<2960000>; regulator-initial-mode=<RPMH_REGULATOR_MODE_HPM>; };
 };
};
&tlmm { sdc2_default: sdc2-default {
 clk-pins { pins="sdc2_clk"; bias-disable; drive-strength=<16>; };
 cmd-pins { pins="sdc2_cmd"; bias-pull-up; drive-strength=<16>; };
 data-pins { pins="sdc2_data"; bias-pull-up; drive-strength=<16>; };
}; };
&sdhc_2 { status="okay"; pinctrl-names="default"; pinctrl-0=<&sdc2_default>;
 vmmc-supply=<&vdd_sd>; vqmmc-supply=<&vdd_io_sd>;
 bus-width=<4>; broken-cd; no-1-8-v; no-sdio; no-mmc;
};
#include "dby-memory-private.dtsi"
/* V1a: reserve a new handle; keep existing nodes/references unchanged. */
&dby_video_mem { phandle = <0x1014>; };
&{/smem} { memory-region=<&dby_smem>; };

// USB2 bring-up: fixed peripheral role; RPMh regulators, no SPMI access.
&apps_rsc {
 usb-regulators {
  compatible = "qcom,pm8150-rpmh-regulators";
  qcom,pmic-id = "a";
  usb_l2a: ldo2 {
   regulator-name = "usb-l2a";
   regulator-min-microvolt = <3072000>;
   regulator-max-microvolt = <3072000>;
   regulator-always-on; regulator-boot-on;
   regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
  };
  usb_l5a: ldo5 {
   regulator-name = "usb-l5a";
   regulator-min-microvolt = <880000>;
   regulator-max-microvolt = <880000>;
   regulator-always-on; regulator-boot-on;
   regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
  };
  usb_l12a: ldo12 {
   regulator-name = "usb-l12a";
   regulator-min-microvolt = <1800000>;
   regulator-max-microvolt = <1800000>;
   regulator-always-on; regulator-boot-on;
   regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
  };
  usb_l18a: ldo18 {
   regulator-name = "usb-l18a";
   regulator-min-microvolt = <912000>;
   regulator-max-microvolt = <912000>;
   regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
  };
 };
};
&usb_1_hsphy {
 status = "okay";
 vdda-pll-supply = <&usb_l5a>;
 vdda18-supply = <&usb_l12a>;
 vdda33-supply = <&usb_l2a>;
};
&usb_1 { status = "okay"; };
&usb_1_dwc3 {
 dr_mode = "otg";
 usb-role-switch;
};
&usb_1_dwc3_hs_out {
 remote-endpoint = <&dby_connector_endpoint>;
};
&usb_1_qmpphy {
 status = "okay";
 vdda-phy-supply = <&usb_l18a>;
 vdda-pll-supply = <&wifi_l9a>;
};
&usb_1_qmpphy_out {
 /* Stock redriver address did not ACK. Use the HDK direct connector graph;
  * the PHY handles orientation. Physical SS wiring remains unverified. */
 remote-endpoint = <&dby_connector_ss>;
};

// PCIe/WLAN bring-up: only PCIe0 and WLAN power sequence.
/ {
	qca6390-pmu {
		compatible = "qcom,qca6390-pmu";

		pinctrl-names = "default";
		pinctrl-0 = <&bt_en_state>, <&wlan_en_state>;

		vddaon-supply = <&wifi_s6a>;
		vddpmu-supply = <&wifi_s6a>;
		vddrfa0p95-supply = <&wifi_s6a>;
		vddrfa1p3-supply = <&wifi_s8c>;
		vddrfa1p9-supply = <&wifi_s5a>;
		vddpcie1p3-supply = <&wifi_s8c>;
		vddpcie1p9-supply = <&wifi_s5a>;
		vddio-supply = <&wifi_s4a>;

		wlan-enable-gpios = <&tlmm 20 GPIO_ACTIVE_HIGH>;
		bt-enable-gpios = <&tlmm 21 GPIO_ACTIVE_HIGH>;

		regulators {
			vreg_pmu_rfa_cmn: ldo0 {
				regulator-name = "vreg_pmu_rfa_cmn";
			};

			vreg_pmu_aon_0p59: ldo1 {
				regulator-name = "vreg_pmu_aon_0p59";
			};

			vreg_pmu_wlcx_0p8: ldo2 {
				regulator-name = "vreg_pmu_wlcx_0p8";
			};

			vreg_pmu_wlmx_0p85: ldo3 {
				regulator-name = "vreg_pmu_wlmx_0p85";
			};

			vreg_pmu_btcmx_0p85: ldo4 {
				regulator-name = "vreg_pmu_btcmx_0p85";
			};

			vreg_pmu_rfa_0p8: ldo5 {
				regulator-name = "vreg_pmu_rfa_0p8";
			};

			vreg_pmu_rfa_1p2: ldo6 {
				regulator-name = "vreg_pmu_rfa_1p2";
			};

			vreg_pmu_rfa_1p7: ldo7 {
				regulator-name = "vreg_pmu_rfa_1p7";
			};

			vreg_pmu_pcie_0p9: ldo8 {
				regulator-name = "vreg_pmu_pcie_0p9";
			};

			vreg_pmu_pcie_1p8: ldo9 {
				regulator-name = "vreg_pmu_pcie_1p8";
			};
		};
	};

};
&apps_rsc { usb-regulators {
wifi_s4a: smps4 { regulator-name="wifi-s4a"; regulator-min-microvolt=<1800000>; regulator-max-microvolt=<1800000>; regulator-always-on; regulator-boot-on; regulator-initial-mode=<RPMH_REGULATOR_MODE_HPM>; };
wifi_s5a: smps5 { regulator-name="wifi-s5a"; regulator-min-microvolt=<1896000>; regulator-max-microvolt=<1900000>; regulator-always-on; regulator-boot-on; regulator-initial-mode=<RPMH_REGULATOR_MODE_HPM>; };
wifi_s6a: smps6 { regulator-name="wifi-s6a"; regulator-min-microvolt=<948000>; regulator-max-microvolt=<950000>; regulator-always-on; regulator-boot-on; regulator-initial-mode=<RPMH_REGULATOR_MODE_HPM>; };
wifi_l9a: ldo9 { regulator-name="wifi-l9a"; regulator-min-microvolt=<1200000>; regulator-max-microvolt=<1200000>; regulator-always-on; regulator-boot-on; regulator-initial-mode=<RPMH_REGULATOR_MODE_HPM>; };
}; };
&apps_rsc { regulators {
wifi_s8c: smps8 { regulator-name="wifi-s8c"; regulator-min-microvolt=<1344000>; regulator-max-microvolt=<1350000>; regulator-always-on; regulator-boot-on; regulator-initial-mode=<RPMH_REGULATOR_MODE_HPM>; };
}; };
&pcie0 {
	status = "okay";
};

&pcie0_phy {
	status = "okay";
	vdda-phy-supply = <&usb_l5a>;
	vdda-pll-supply = <&wifi_l9a>;
};

&pcieport0 {
	wifi@0 {
		compatible = "pci17cb,1101";
		reg = <0x10000 0x0 0x0 0x0 0x0>;

		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
		vddaon-supply = <&vreg_pmu_aon_0p59>;
		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
		vddrfa1p7-supply = <&vreg_pmu_rfa_1p7>;
		vddpcie0p9-supply = <&vreg_pmu_pcie_0p9>;
		vddpcie1p8-supply = <&vreg_pmu_pcie_1p8>;
	};
};

&tlmm {
	bt_en_state: bt-default-state {
		pins = "gpio21";
		function = "gpio";
		drive-strength = <16>;
		output-low;
		bias-pull-up;
	};

	wlan_en_state: wlan-default-state {
		pins = "gpio20";
		function = "gpio";
		drive-strength = <16>;
		output-low;
		bias-pull-up;
	};

};

&uart6 {
 status = "okay";
 bluetooth {
  compatible = "qcom,qca6390-bt";
  vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
  vddaon-supply = <&vreg_pmu_aon_0p59>;
  vddbtcmx-supply = <&vreg_pmu_btcmx_0p85>;
  vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
  vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
  vddrfa1p7-supply = <&vreg_pmu_rfa_1p7>;
 };
};

/* GPIO6 key baseline; later key integration enables standard PON keys. */
&pon { status = "okay"; };
&pon_pwrkey { status = "okay"; };
&pon_resin { status = "okay"; linux,code = <KEY_VOLUMEDOWN>; };
&pm8150_temp { status = "disabled"; };
&pm8150_adc { status = "disabled"; };
&pm8150_adc_tm { status = "disabled"; };
&{/soc@0/spmi@c440000/pmic@0/rtc@6000} { qcom,no-alarm; };
&{/thermal-zones/pm8150-thermal} { status = "disabled"; };

&pm8150_gpios {
    status = "okay";
    vol_up: vol-up-state {
        pins = "gpio6";
        function = "normal";
        input-enable;
        bias-pull-up;
        power-source = <1>;
    };
};

/ {
    gpio-keys {
        compatible = "gpio-keys";
        pinctrl-names = "default";
        pinctrl-0 = <&vol_up>;
        key-volume-up {
            label = "Volume Up";
            gpios = <&pm8150_gpios 6 GPIO_ACTIVE_LOW>;
            linux,code = <KEY_VOLUMEUP>;
            debounce-interval = <15>;
        };
    };
};

/* Project dual C-PHY display integration. See provenance.md. */
/* Inherit the unchanged baseline without duplicating private configuration. */
#include <dt-bindings/phy/phy.h>

&dispcc { status = "okay"; };
&mdss { status = "okay"; };
&mdss_mdp { status = "okay"; };
&refgen { status = "okay"; };

&apps_rsc {
	usb-regulators {
		display_l14a: ldo14 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-always-on;
			regulator-boot-on;
		};
	};
};

&mdss_dsi0 {
	status = "okay";
	vdda-supply = <&wifi_l9a>;
	qcom,dual-dsi-mode;
	qcom,sync-dual-dsi;
	qcom,master-dsi;

	panel@0 {
		compatible = "huawei,dby-w09-nt36523", "novatek,nt36523";
		reg = <0>;
		vddio-supply = <&display_l14a>;
		reset-gpios = <&tlmm 38 GPIO_ACTIVE_LOW>;
		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				reg = <0>;
				panel_in_0: endpoint { remote-endpoint = <&mdss_dsi0_out>; };
			};
			port@1 {
				reg = <1>;
				panel_in_1: endpoint { remote-endpoint = <&mdss_dsi1_out>; };
			};
		};
	};
};

&mdss_dsi1 {
	status = "okay";
	vdda-supply = <&wifi_l9a>;
	qcom,dual-dsi-mode;
	qcom,sync-dual-dsi;
	assigned-clock-parents = <&mdss_dsi0_phy DSI_BYTE_PLL_CLK>,
				 <&mdss_dsi0_phy DSI_PIXEL_PLL_CLK>;
};

&mdss_dsi0_out {
	data-lanes = <0 1 2>;
	remote-endpoint = <&panel_in_0>;
};
&mdss_dsi1_out {
	data-lanes = <0 1 2>;
	remote-endpoint = <&panel_in_1>;
};
&mdss_dsi0_phy {
	status = "okay";
	phy-type = <PHY_TYPE_CPHY>;
	vdds-supply = <&usb_l5a>;
};
&mdss_dsi1_phy {
	status = "okay";
	phy-type = <PHY_TYPE_CPHY>;
	vdds-supply = <&usb_l5a>;
};

/* Project backlight I2C controller enablement. See provenance.md. */

&qupv3_id_1 { status = "okay"; };
&gpi_dma1 { status = "okay"; };
&i2c11 { status = "okay"; };

/* Project I2C backlight node. See provenance.md. */

&i2c11 {
	backlight@31 {
		compatible = "richtek,rt8555";
		reg = <0x31>;
	};
};

/* Project legacy SPI touch wiring. See provenance.md. */
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

&qupv3_id_2 { status = "okay"; };
&tlmm {
	touch_irq_default: touch-irq-default-state {
		pins = "gpio39";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};
	touch_reset_default: touch-reset-default-state {
		pins = "gpio98";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};
};
&spi14 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&qup_spi14_cs &qup_spi14_data_clk>;
	touchscreen@0 {
		compatible = "novatek,nt36523-spi";
		reg = <0>;
		spi-max-frequency = <8000000>;
		interrupts-extended = <&tlmm 39 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&tlmm 98 GPIO_ACTIVE_LOW>;
		firmware-name = "novatek/nt36523-csot.bin";
		pinctrl-names = "default";
		pinctrl-0 = <&touch_irq_default &touch_reset_default>;
	};
};

/* Project read-only battery gauge integration. See provenance.md. */
#include <dt-bindings/spmi/spmi.h>
#include <dt-bindings/iio/qcom,spmi-vadc.h>

&spmi_bus {
	pmic@2 {
		compatible = "qcom,pm8150b", "qcom,spmi-pmic";
		reg = <0x2 SPMI_USID>;
		#address-cells = <1>;
		#size-cells = <0>;

		pm8150b_adc: adc@3100 {
			compatible = "qcom,spmi-adc5";
			reg = <0x3100>;
			#address-cells = <1>;
			#size-cells = <0>;
			#io-channel-cells = <1>;
			interrupts = <0x2 0x31 0x0 IRQ_TYPE_EDGE_RISING>;
			status = "okay";

			channel@2a {
				reg = <ADC5_BAT_THERM_30K_PU>;
				label = "bat_therm_30k";
				qcom,ratiometric;
				qcom,hw-settle-time = <200>;
				qcom,pre-scaling = <1 1>;
			};

			channel@6 {
				reg = <ADC5_DIE_TEMP>;
				label = "die_temp";
				qcom,pre-scaling = <1 1>;
			};

			channel@9 {
				reg = <ADC5_CHG_TEMP>;
				label = "chg_temp";
				qcom,pre-scaling = <1 1>;
			};
		};

		charger@1000 {
			compatible = "dby,pm8150b-charger";
			reg = <0x1000>;
			power-supplies = <&pm8150b_typec>;
			interrupts = <0x2 0x10 0x1 IRQ_TYPE_EDGE_RISING>,
				     <0x2 0x13 0x4 IRQ_TYPE_EDGE_BOTH>,
				     <0x2 0x16 0x1 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "chg-state-change", "usbin-plugin", "wdog-bark";
			io-channels = <&pm8150b_adc ADC5_BAT_THERM_30K_PU>,
				      <&pm8150b_adc ADC5_CHG_TEMP>;
			io-channel-names = "batt_therm", "chg_temp";
		};

		battery@4000 {
			compatible = "dby,pm8150b-fg-readonly";
			reg = <0x4000>, <0x4100>;
			monitored-battery = <&battery>;
			interrupts = <0x2 0x40 0x3 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "msoc-delta";
		};
	};
};

/* Project SD I/O voltage adjustment. See provenance.md. */
&vdd_io_sd { regulator-min-microvolt = <1800000>; };
&sdhc_2 { /delete-property/ no-1-8-v; };

/* Project panel-to-backlight reference. See provenance.md. */

&i2c11 {
	rt8555_backlight: backlight@31 {
	};
};

&mdss_dsi0 {
	panel@0 {
		backlight = <&rt8555_backlight>;
	};
};

/* Project GPU bring-up. See provenance.md. */
/* GPU test DT only; defaults follow the earlier display/backlight baseline.
 * Nodes and ZAP path copied from the earlier offline GPU draft.
 */

/* The existing speed_bin cell refers to this disabled provider.
 * GPU only reads the cell; this draft does not program any fuse.
 */
&qfprom {
	status = "okay";
};

&gpucc {
	status = "okay";
};

&adreno_smmu {
	status = "okay";
};

&gmu {
	status = "okay";
};

&gpu {
	status = "okay";
};

&gpu_zap_shader {
	memory-region = <&dby_gpu_zap_mem>;
	firmware-name = "qcom/sm8250/huawei/dby-w09/a650_zap.elf";
};

/* LLCC remains as in the earlier display baseline (disabled): a6xx_llc_slices_init accepts error
 * pointers and cache activation is optional. Enabling its existing node can
 * be evaluated separately; it is not necessary for this minimal draft.
 */

/* Project temporary display-hold removal. See provenance.md. */

/delete-node/ &{/display-hold};

/* Project IPCC mailbox enablement. See provenance.md. */

&{/soc@0/mailbox@408000} {
	status = "okay";
};

/* Project THP touch wiring. See provenance.md. */
/* Offline TF6 candidate; no automatic THP module load or firmware transfer. */
#include <dt-bindings/interrupt-controller/irq.h>

/* The baseline already has a legacy touch node; remove reset ownership. */
/delete-node/ &{/soc@0/pinctrl@f100000/touch-reset-default-state};

&qupv3_id_2 { status = "okay"; };

&mdss_dsi0 {
	thp_panel: panel@0 { };
};

&tlmm {
	thp_irq_default: thp-irq-default-state {
		pins = "gpio39";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};
};

&spi14 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&qup_spi14_cs &qup_spi14_data_clk>;

	touchscreen@0 {
		/delete-property/ reset-gpios;
		/delete-property/ firmware-name;
		compatible = "novatek,nt36523-thp";
		reg = <0>;
		spi-max-frequency = <16000000>;
		/* CPOL/CPHA absent: mode 0; SPI core defaults to 8 bits per word. */
		interrupts-extended = <&tlmm 39 IRQ_TYPE_EDGE_FALLING>;
		panel = <&thp_panel>;
		pinctrl-names = "default";
		pinctrl-0 = <&thp_irq_default>;
	};
};

/* Project USB integration; IRQ declaration from upstream pm8150b.dtsi. */

#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/usb/pd.h>

&{/soc@0/spmi@c440000/pmic@2} {
    dby_usb_vbus: usb-vbus-regulator@1100 {
        compatible = "qcom,pm8150b-vbus-reg";
        reg = <0x1100>;
        status = "okay";
        regulator-min-microamp = <500000>;
        regulator-max-microamp = <500000>;
    };
    pm8150b_typec: typec@1500 {
        compatible = "qcom,pm8150b-typec";
        reg = <0x1500>, <0x1700>;
        status = "okay";
			interrupts = <0x2 0x15 0x00 IRQ_TYPE_EDGE_RISING>,
				     <0x2 0x15 0x01 IRQ_TYPE_EDGE_BOTH>,
				     <0x2 0x15 0x02 IRQ_TYPE_EDGE_RISING>,
				     <0x2 0x15 0x03 IRQ_TYPE_EDGE_BOTH>,
				     <0x2 0x15 0x04 IRQ_TYPE_EDGE_RISING>,
				     <0x2 0x15 0x05 IRQ_TYPE_EDGE_RISING>,
				     <0x2 0x15 0x06 IRQ_TYPE_EDGE_BOTH>,
				     <0x2 0x15 0x07 IRQ_TYPE_EDGE_RISING>,
				     <0x2 0x17 0x00 IRQ_TYPE_EDGE_RISING>,
				     <0x2 0x17 0x01 IRQ_TYPE_EDGE_RISING>,
				     <0x2 0x17 0x02 IRQ_TYPE_EDGE_RISING>,
				     <0x2 0x17 0x03 IRQ_TYPE_EDGE_RISING>,
				     <0x2 0x17 0x04 IRQ_TYPE_EDGE_RISING>,
				     <0x2 0x17 0x05 IRQ_TYPE_EDGE_RISING>,
				     <0x2 0x17 0x06 IRQ_TYPE_EDGE_RISING>,
				     <0x2 0x17 0x07 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "or-rid-detect-change",
					  "vpd-detect",
					  "cc-state-change",
					  "vconn-oc",
					  "vbus-change",
					  "attach-detach",
					  "legacy-cable-detect",
					  "try-snk-src-detect",
					  "sig-tx",
					  "sig-rx",
					  "msg-tx",
					  "msg-rx",
					  "msg-tx-failed",
					  "msg-tx-discarded",
					  "msg-rx-discarded",
					  "fr-swap";
        vdd-pdphy-supply = <&usb_l2a>;
        connector {
            compatible = "usb-c-connector";
            label = "USB-C";
            power-role = "dual";
            data-role = "dual";
            try-power-role = "sink";
            vbus-supply = <&dby_usb_vbus>;
            source-pdos = <PDO_FIXED(5000, 500, PDO_FIXED_DUAL_ROLE |
                           PDO_FIXED_USB_COMM | PDO_FIXED_DATA_SWAP)>;
            sink-pdos = <PDO_FIXED(5000, 2000, PDO_FIXED_DUAL_ROLE |
                         PDO_FIXED_USB_COMM | PDO_FIXED_DATA_SWAP)
                         PDO_FIXED(9000, 3000, PDO_FIXED_DUAL_ROLE |
                         PDO_FIXED_USB_COMM | PDO_FIXED_DATA_SWAP)>;
            op-sink-microwatt = <27000000>;
            ports {
                #address-cells = <1>;
                #size-cells = <0>;
                port@0 {
                    reg = <0>;
                    dby_connector_endpoint: endpoint {
                        remote-endpoint = <&usb_1_dwc3_hs_out>;
                    };
                };
                port@1 {
                    reg = <1>;
                    dby_connector_ss: endpoint {
                        remote-endpoint = <&usb_1_qmpphy_out>;
                    };
                };
            };
        };
    };
};

/* Experimental capture topology. Sound/DAI and WCD supply structure follow
 * upstream sm8250-mtp.dts; board reset, SoundWire ports, micbias and AMIC
 * routing retain device-tested board parameters from the stock DT investigation.
 * No playback DAI, speaker amplifier or WSA macro is enabled.
 */
dby_adsp_mem: &{/reserved-memory/pil_adsp_region@8a100000} { };
&adsp {
    status = "okay";
    memory-region = <&dby_adsp_mem>;
    firmware-name = "qcom/dby-w09/adsp.mdt";
};
&{/smp2p-adsp} { status = "okay"; };
#include <dt-bindings/sound/qcom,q6afe.h>
#include <dt-bindings/sound/qcom,q6asm.h>

&lpass_tlmm {
    status = "okay";
    dmic23_active: dmic23-active-state {
        clk-pins {
            pins = "gpio8";
            function = "dmic2_clk";
            drive-strength = <8>;
            output-high;
        };
        data-pins {
            pins = "gpio9";
            function = "dmic2_data";
            drive-strength = <8>;
            input-enable;
        };
    };
    dmic23_sleep: dmic23-sleep-state {
        clk-pins {
            pins = "gpio8";
            function = "dmic2_clk";
            drive-strength = <2>;
            bias-disable;
            output-low;
        };
        data-pins {
            pins = "gpio9";
            function = "dmic2_data";
            drive-strength = <2>;
            bias-pull-down;
            input-enable;
        };
    };
};

&vamacro {
    status = "okay";
    qcom,dmic-sample-rate = <600000>;
    pinctrl-names = "default", "sleep";
    pinctrl-0 = <&dmic01_active &dmic23_active>;
    pinctrl-1 = <&dmic01_sleep &dmic23_sleep>;
};

&sound {
    compatible = "qcom,sm8250-sndcard";
    model = "DBY-W09";
    audio-routing = "DMIC0 Pin", "vdd-micb",
                    "DMIC1 Pin", "vdd-micb",
                    "DMIC2 Pin", "vdd-micb",
                    "DMIC3 Pin", "vdd-micb";
    mm1-dai-link {
        link-name = "MultiMedia1";
        cpu { sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>; };
    };
    mm2-dai-link {
        link-name = "MultiMedia2";
        cpu { sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA2>; };
    };
    va-dai-link {
        link-name = "VA Capture";
        cpu { sound-dai = <&q6afedai VA_CODEC_DMA_TX_0>; };
        platform { sound-dai = <&q6routing>; };
        codec { sound-dai = <&vamacro 0>; };
    };
};

&q6asmdai {
    dai@0 { reg = <MSM_FRONTEND_DAI_MULTIMEDIA1>; };
    dai@1 { reg = <MSM_FRONTEND_DAI_MULTIMEDIA2>; };
};

&q6afedai {
    dai@6e { reg = <VA_CODEC_DMA_TX_0>; };
};
/ {
    vph_pwr: vph-pwr-regulator {
        compatible = "regulator-fixed";
        regulator-name = "vph_pwr";
        regulator-min-microvolt = <3700000>;
        regulator-max-microvolt = <3700000>;
    };
    wcd938x: audio-codec {
        compatible = "qcom,wcd9380-codec";
        reset-gpios = <&tlmm 32 GPIO_ACTIVE_LOW>;
        vdd-buck-supply = <&wifi_s4a>;
        vdd-rxtx-supply = <&wifi_s4a>;
        vdd-io-supply = <&wifi_s4a>;
        vdd-mic-bias-supply = <&vreg_bob>;
        qcom,micbias1-microvolt = <1800000>;
        qcom,micbias2-microvolt = <1800000>;
        qcom,micbias3-microvolt = <1800000>;
        qcom,micbias4-microvolt = <1800000>;
        qcom,mbhc-buttons-vthreshold-microvolt = <75000 150000 237000 500000 500000 500000 500000 500000>;
        qcom,mbhc-headset-vthreshold-microvolt = <1700000>;
        qcom,mbhc-headphone-vthreshold-microvolt = <50000>;
        qcom,rx-device = <&wcd_rx>;
        qcom,tx-device = <&wcd_tx>;
        #sound-dai-cells = <1>;
    };
};
&{/soc@0/rsc@18200000/regulators} {
    vdd-bob-supply = <&vph_pwr>;
    vreg_bob: bob {
        regulator-name = "vreg_bob";
        regulator-min-microvolt = <3008000>;
        regulator-max-microvolt = <3960000>;
        regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
    };
};
&rxmacro { status = "okay"; };
&txmacro { status = "okay"; };
&swr1 {
    status = "okay";
    wcd_rx: wcd9380-rx@0,4 {
        compatible = "sdw20217010d00";
        reg = <0 4>;
        qcom,rx-port-mapping = <1 2 3 4 5>;
    };
};
&swr2 {
    status = "okay";
    wcd_tx: wcd9380-tx@0,3 {
        compatible = "sdw20217010d00";
        reg = <0 3>;
        qcom,tx-port-mapping = <2 3 4 5>;
    };
};
&sound {
    audio-routing = "DMIC0 Pin", "vdd-micb", "DMIC1 Pin", "vdd-micb",
                    "DMIC2 Pin", "vdd-micb", "DMIC3 Pin", "vdd-micb",
                    "DMIC0 Pin", "MIC BIAS3", "DMIC1 Pin", "MIC BIAS3",
                    "DMIC2 Pin", "MIC BIAS1", "DMIC3 Pin", "MIC BIAS1";
    wcd-capture-dai-link {
        link-name = "WCD Capture";
        cpu { sound-dai = <&q6afedai TX_CODEC_DMA_TX_3>; };
        codec { sound-dai = <&wcd938x 1>, <&swr2 0>, <&txmacro 0>; };
        platform { sound-dai = <&q6routing>; };
    };
};
&q6afedai { dai@78 { reg = <TX_CODEC_DMA_TX_3>; }; };
&vamacro { qcom,dmic-sample-rate = <2400000>; };
&sound {
    audio-routing =
        "DMIC0 Pin", "vdd-micb",
        "DMIC1 Pin", "vdd-micb",
        "DMIC2 Pin", "vdd-micb",
        "DMIC3 Pin", "vdd-micb",
        "DMIC0 Pin", "MIC BIAS3",
        "DMIC1 Pin", "MIC BIAS3",
        "DMIC2 Pin", "MIC BIAS1",
        "DMIC3 Pin", "MIC BIAS1",
        "AMIC1", "MIC BIAS3",
        "AMIC3", "MIC BIAS4",
        "AMIC4", "MIC BIAS1",
        "AMIC5", "MIC BIAS1",
        "TX SWR_ADC0", "ADC1_OUTPUT",
        "TX SWR_ADC1", "ADC2_OUTPUT",
        "TX SWR_ADC2", "ADC3_OUTPUT",
        "TX SWR_ADC3", "ADC4_OUTPUT";
};

/* Reserve audio-only handles outside the baseline range so enabling capture
 * does not renumber unrelated display, input, radio or charger references. */
&{/reserved-memory/pil_adsp_region@8a100000} { phandle = <0x1000>; };
&{/soc@0/soundwire@3210000/wcd9380-rx@0,4} { phandle = <0x1001>; };
&{/soc@0/soundwire@3230000} { phandle = <0x1002>; };
&{/soc@0/soundwire@3230000/wcd9380-tx@0,3} { phandle = <0x1003>; };
&{/soc@0/pinctrl@33c0000/dmic01-active-state} { phandle = <0x1004>; };
&{/soc@0/pinctrl@33c0000/dmic01-sleep-state} { phandle = <0x1005>; };
&{/soc@0/pinctrl@33c0000/dmic23-active-state} { phandle = <0x1006>; };
&{/soc@0/pinctrl@33c0000/dmic23-sleep-state} { phandle = <0x1007>; };
&{/soc@0/remoteproc@17300000/glink-edge/apr/service@4/dais} { phandle = <0x1008>; };
&{/soc@0/remoteproc@17300000/glink-edge/apr/service@7/dais} { phandle = <0x1009>; };
&{/soc@0/remoteproc@17300000/glink-edge/apr/service@8/routing} { phandle = <0x100a>; };
&{/soc@0/rsc@18200000/regulators/bob} { phandle = <0x100b>; };
&{/vph-pwr-regulator} { phandle = <0x100c>; };
&{/audio-codec} { phandle = <0x100d>; };

/* Primary TDM speaker transport; codec power remains explicitly locked. */
&gpi_dma0 { status = "okay"; };

&i2c3 {
	status = "okay";
	clock-frequency = <400000>;

	tfa9874_0: tfa9874@34 {
		compatible = "huawei,dby-tfa9874";
		reg = <0x34>;
		reset-gpios = <&tlmm 109 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&tfa9874_rst_default>;
		huawei,pa-index = <0>;
		sound-name-prefix = "SpkrMono0";
		#sound-dai-cells = <0>;
	};

	tfa9874_1: tfa9874@35 {
		compatible = "huawei,dby-tfa9874";
		reg = <0x35>;
		huawei,pa-index = <1>;
		sound-name-prefix = "SpkrMono1";
		#sound-dai-cells = <0>;
	};

	tfa9874_2: tfa9874@36 {
		compatible = "huawei,dby-tfa9874";
		reg = <0x36>;
		huawei,pa-index = <2>;
		sound-name-prefix = "SpkrMono2";
		#sound-dai-cells = <0>;
	};

	tfa9874_3: tfa9874@37 {
		compatible = "huawei,dby-tfa9874";
		reg = <0x37>;
		huawei,pa-index = <3>;
		sound-name-prefix = "SpkrMono3";
		#sound-dai-cells = <0>;
	};
};

&tlmm {
	pri_tdm_active: pri-tdm-active-state {
		sck-pins {
			pins = "gpio138";
			function = "mi2s0_sck";
			drive-strength = <8>;
			bias-disable;
		};
		data0-pins {
			pins = "gpio139";
			function = "mi2s0_data0";
			drive-strength = <8>;
			bias-disable;
		};
		data1-pins {
			pins = "gpio140";
			function = "mi2s0_data1";
			drive-strength = <8>;
			bias-disable;
		};
		ws-pins {
			pins = "gpio141";
			function = "mi2s0_ws";
			drive-strength = <8>;
			bias-disable;
		};
	};
	tfa9874_rst_default: tfa9874-rst-default-state {
		pins = "gpio109";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
		output-low;
	};
};

&q6afedai {
	dai@24 {
		reg = <PRIMARY_TDM_RX_0>;
		qcom,tdm-sync-mode = <2>;
		qcom,tdm-sync-src = <1>;
		qcom,tdm-data-out = <0>;
		qcom,tdm-invert-sync = <1>;
		qcom,tdm-data-delay = <1>;
		qcom,tdm-data-align = <0>;
	};
};

&sound {
	pinctrl-names = "default";
	pinctrl-0 = <&pri_tdm_active>;
	primary-tdm-playback-dai-link {
		link-name = "Primary TDM0 Playback";
		cpu { sound-dai = <&q6afedai PRIMARY_TDM_RX_0>; };
		platform { sound-dai = <&q6routing>; };
		codec { sound-dai = <&tfa9874_0>, <&tfa9874_1>, <&tfa9874_2>, <&tfa9874_3>; };
	};
};
&{/soc@0/pinctrl@f100000/pri-tdm-active-state} { phandle = <0x100e>; };
&{/soc@0/pinctrl@f100000/tfa9874-rst-default-state} { phandle = <0x100f>; };
&{/soc@0/geniqup@9c0000/i2c@98c000/tfa9874@34} { phandle = <0x1010>; };
&{/soc@0/geniqup@9c0000/i2c@98c000/tfa9874@35} { phandle = <0x1011>; };
&{/soc@0/geniqup@9c0000/i2c@98c000/tfa9874@36} { phandle = <0x1012>; };
&{/soc@0/geniqup@9c0000/i2c@98c000/tfa9874@37} { phandle = <0x1013>; };

/* Temporary Hall probe supply; the final power policy belongs to H2. */
&apps_rsc {
	regulators {
		vreg_l8c_1p8: ldo8 {
			regulator-name = "vreg_l8c_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-always-on;
			regulator-boot-on;
		};
	};
};

&tlmm {
	hall_probe_default: hall-probe-default-state {
		pins = "gpio23", "gpio113", "gpio121";
		function = "gpio";
		bias-pull-up;
		drive-strength = <2>;
		input-enable;
	};
};

/ {
	hall-probe {
		compatible = "gpio-keys";
		label = "hall-probe";
		pinctrl-names = "default";
		pinctrl-0 = <&hall_probe_default>;

		/* Active-low is a probe assumption; verify polarity on hardware.
		 * Accessory mapping is unknown. These are observation codes only.
		 */
		switch-hall1 {
			gpios = <&tlmm 121 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_SW>;
			linux,code = <SW_KEYPAD_SLIDE>;
			debounce-interval = <20>;
		};
		switch-hall2 {
			gpios = <&tlmm 23 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_SW>;
			linux,code = <SW_DOCK>;
			debounce-interval = <20>;
		};
	};
};

/ {
	/* hall0 already activates near 45 degrees: blanking starts half closed.
	 * hall2 also detects the pen, so it must not drive lid blanking.
	 * A fully-closed policy would need H2 option 2 instead.
	 */
	hall-lid {
		compatible = "gpio-keys";
		label = "hall-lid";
		pinctrl-names = "default";
		pinctrl-0 = <&hall_probe_default>;
		switch-lid {
			gpios = <&tlmm 113 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_SW>;
			linux,code = <SW_LID>;
			debounce-interval = <200>;
		};
	};
};

/* Panel rails: preserve boot GPIO levels until the driver power cycle. */

/ {
    panel_iovcc: regulator-panel-iovcc {
        compatible = "regulator-fixed";
        regulator-name = "panel-iovcc";
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
        gpios = <&tlmm 6 GPIO_ACTIVE_HIGH>;
        enable-active-high;
        regulator-boot-on;
        vin-supply = <&display_l14a>;
    };
    panel_vsp: regulator-panel-vsp {
        compatible = "regulator-fixed";
        regulator-name = "panel-vsp";
        regulator-min-microvolt = <5700000>;
        regulator-max-microvolt = <5700000>;
        gpios = <&tlmm 11 GPIO_ACTIVE_HIGH>;
        enable-active-high;
        regulator-boot-on;
    };
    panel_vsn: regulator-panel-vsn {
        compatible = "regulator-fixed";
        regulator-name = "panel-vsn";
        regulator-min-microvolt = <5700000>;
        regulator-max-microvolt = <5700000>;
        gpios = <&tlmm 12 GPIO_ACTIVE_HIGH>;
        enable-active-high;
        regulator-boot-on;
    };
};
&apps_rsc {
    regulators {
        panel_vci: ldo11 {
            regulator-name = "panel-vci";
            regulator-min-microvolt = <3200000>;
            regulator-max-microvolt = <3300000>;
            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
        };
    };
};
&mdss_dsi0 {
    panel@0 {
        vci-supply = <&panel_vci>;
        vddio-supply = <&panel_iovcc>;
        vsp-supply = <&panel_vsp>;
        vsn-supply = <&panel_vsn>;
    };
};
